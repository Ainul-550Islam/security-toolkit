# Example configuration for security-toolkit.
#
# Copy to .env for local development. NEVER commit a filled-in .env --
# .gitignore excludes it. Every value below is a placeholder; none is real.
#
# Unset, empty and invalid are treated DIFFERENTLY: an empty value for a
# required setting is an error, not "use the default".

# --- Deployment mode: development | test | production ----------------------
SECTOOLKIT_ENV=development

# --- HTTP surface ----------------------------------------------------------
# Defaults to loopback. Binding to 0.0.0.0 requires ALLOW_INSECURE_BIND below
# and is refused outright in production.
SECTOOLKIT_BIND_HOST=127.0.0.1
SECTOOLKIT_BIND_PORT=8000
SECTOOLKIT_ALLOW_INSECURE_BIND=false

# --- Security toggles (all default to the restrictive setting) -------------
SECTOOLKIT_AUTH_REQUIRED=true
SECTOOLKIT_TLS_REQUIRED=true
SECTOOLKIT_DEBUG=false

# --- Paths -----------------------------------------------------------------
# SECTOOLKIT_WORKSPACE=changeme
# SECTOOLKIT_DATA_DIR=changeme

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
SECTOOLKIT_LOG_LEVEL=INFO
# json | text
SECTOOLKIT_LOG_FORMAT=json

# --- Secret provider: env | file | vault | kms -----------------------------
SECTOOLKIT_SECRETS_PROVIDER=env

# --- Native engines (not wired to Python in PART 01) -----------------------
SECTOOLKIT_ENABLE_RUST=false
SECTOOLKIT_ENABLE_CPP=false

# --- Feature flags ---------------------------------------------------------
SECTOOLKIT_FEATURE_RUST_ENGINE=false
SECTOOLKIT_FEATURE_CPP_ENGINE=false
# The two below are production-locked: setting them true has no effect when
# SECTOOLKIT_ENV=production.
SECTOOLKIT_FEATURE_EXPERIMENTAL_API=false
SECTOOLKIT_FEATURE_VERBOSE_ERRORS=false

# --- Secrets ---------------------------------------------------------------
# Resolved through interfaces/secrets.py with the SECTOOLKIT_SECRET_ prefix.
# Placeholders only; never commit a real value.
# SECTOOLKIT_SECRET_WEBHOOK=changeme

# --- Authenticated encryption keyring --------------------------------------
# Supply an AES-256 key as strict base64 of exactly 32 random bytes through a
# secret manager or protected process environment. Never commit real values.
# Generate one with: python3 -c 'import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())'
# SECURITY_TOOLKIT_ENCRYPTION_ACTIVE_KEY_ID=key-2026-01
# SECURITY_TOOLKIT_ENCRYPTION_KEY=BASE64_OF_32_RANDOM_BYTES
# During rotation, retain old key IDs for ciphertext decryption:
# SECURITY_TOOLKIT_ENCRYPTION_KEY_key-2025-01=BASE64_OF_OLD_32_BYTE_KEY

# --- Legacy dashboard access -----------------------------------------------
# Prefer this environment variable over the --token CLI option so the token
# does not appear in process arguments. Remote access also requires trusted TLS.
# SECURITY_TOOLKIT_DASHBOARD_TOKEN=REPLACE_WITH_RANDOM_DASHBOARD_TOKEN

# --- Platform operator API (separate from tenant identities/RBAC) ----------
# Use an independently generated 32+ character URL-safe token; never reuse a
# tenant session/API credential. When unset, /api/v1/admin/* fails closed.
# SECURITY_TOOLKIT_PLATFORM_ADMIN_TOKEN=REPLACE_WITH_RANDOM_OPERATOR_TOKEN
